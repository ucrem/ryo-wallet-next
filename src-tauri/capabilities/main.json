{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Foundation window with scoped wallet status and a native data-folder picker.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-status",
    "allow-wallet-overview",
    "allow-data-root",
    "allow-node-configuration",
    "core:app:allow-version",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/ucrem/ryo-wallet-next/releases/tag/v*" }]
    }
  ]
}
