{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Foundation window with scoped wallet status and a native data-folder picker.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-status",
    "allow-app-settings",
    "allow-app-updates",
    "allow-app-diagnostics",
    "allow-wallet-overview",
    "allow-wallet-receive",
    "allow-wallet-lifecycle",
    "allow-wallet-operations",
    "allow-data-root",
    "allow-node-configuration",
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/ucrem/ryo-wallet-next/releases/tag/v*" }, { "url": "https://explorer.ryo-currency.com/tx/*" }]
    }
  ]
}
