{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ryo Wallet Next",
  "version": "0.1.0-alpha.5",
  "identifier": "io.github.ucrem.ryowalletnext",
  "build": {
    "beforeDevCommand": "node scripts/prepare-dev-runtime.mjs && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/prepare-package-runtime.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [{ "title": "Ryo Wallet Next", "width": 1400, "height": 800, "minWidth": 1400, "minHeight": 800 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "ucrem",
    "homepage": "https://github.com/ucrem/ryo-wallet-next",
    "shortDescription": "Independent Ryo desktop wallet prototype",
    "longDescription": "Development preview of an independent Ryo desktop wallet with a verified bundled wallet RPC runtime.",
    "externalBin": ["binaries/ryo-wallet-rpc"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxM0FCMzdFRkIxRkNBQzIKUldUQ3loLzdmck02MGRVdC9iVTNsU3lETEE1QkZ0enllNEhZMktoMG5LNGp5cDRqdi8wM3pCWVAK",
      "endpoints": ["https://raw.githubusercontent.com/ucrem/ryo-wallet-next/update-channel/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
